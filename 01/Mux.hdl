// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not(in=sel , out=ns );
    Nand(a=a , b=ns , out= na);
    Nand(a=b, b=sel , out= nb);
    Nand(a=na , b=nb , out=out );
    //// Replace this comment with your code.
}